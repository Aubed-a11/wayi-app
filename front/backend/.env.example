# ============================================================
# WAYI — Variables d'environnement
# Copier ce fichier en .env et remplir les vraies clés
# NE JAMAIS committer le fichier .env
# ============================================================

NODE_ENV=development
PORT=3001
# Adresse d'écoute. Laissez vide en développement. Sur un serveur avec Nginx devant : 127.0.0.1
# (écrit automatiquement par deploy/setup-vps.sh) pour que l'API ne soit pas exposée directement.
HOST=

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=wayi-super-secret-2026-calavi-change-in-prod

# ── COMPTES DE DÉMONSTRATION ─────────────────────────────────
# Sans ces variables, le compte administrateur de démo (admin@wayi.bj) a le mot de passe « wayi2026 »,
# connu de tous. EN PRODUCTION, DÉFINISSEZ ADMIN_PASSWORD (10 caractères minimum, sans espace ni #).
# deploy/setup-vps.sh en génère un automatiquement et l'écrit ici.
ADMIN_PASSWORD=
# Facultatif : e-mail de connexion de l'administrateur (par défaut admin@wayi.bj)
ADMIN_EMAIL=
# Facultatif : nouveau mot de passe des comptes de démo client (adele@gmail.com) et livreurs
DEMO_PASSWORD=

# ── POSTGRESQL (sauvegarde/restauration de l'état complet) ───
# Sans cette variable, l'app fonctionne normalement mais perd toutes ses
# données (commandes, comptes créés...) à chaque redémarrage. Avec, l'état
# est sauvegardé automatiquement toutes les 30s et restauré au démarrage —
# voir backend/services/database/postgres.js pour le détail de l'approche.
# Un vrai serveur PostgreSQL tourne dans un conteneur Docker sur le VPS
# (voir DEPLOIEMENT.md pour la commande `docker run` de mise en place) ;
# le schéma (table app_state) est créé automatiquement au premier démarrage.
DATABASE_URL=postgresql://wayi:ton_mot_de_passe@127.0.0.1:5433/wayi
# Optionnel : change cette clé si tu fais tourner plusieurs environnements
# (staging/prod) sur la même base, pour ne pas mélanger leurs données.
DB_STATE_KEY=wayi-main

# ── KKIAPAY (paiement MTN MoMo + Moov + carte) ───────────────
# Dès que les 3 clés ci-dessous sont remplies, l'appli passe automatiquement sur Kkiapay.
# Commence par KKIAPAY_SANDBOX=true (mode test Kkiapay, aucun vrai prélèvement), puis false pour l'argent réel.
# URL de webhook à déclarer dans le dashboard Kkiapay : https://api.wayibenin.com/api/payments/webhook/kkiapay
KKIAPAY_PUBLIC_KEY=your_kkiapay_public_key
KKIAPAY_PRIVATE_KEY=your_kkiapay_private_key
KKIAPAY_SECRET=your_kkiapay_secret
KKIAPAY_SANDBOX=true
# Secret de hachage défini dans le dashboard KKiaPay (onglet Webhook) — sans lui, les
# webhooks entrants sont acceptés sans vérification de signature (voir routes/payments.js)
KKIAPAY_WEBHOOK_SECRET=your_kkiapay_webhook_hash_secret
# Obtenir sur : https://kkiapay.me → Dashboard → API Keys
# Sandbox disponible sans KYC pour les tests

# ── MTN MOMO API (direct) ────────────────────────────────────
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_subscription_key
MTN_MOMO_API_USER=your_api_user_uuid
MTN_MOMO_API_KEY=your_api_key
MTN_MOMO_TARGET_ENV=sandbox
# Obtenir sur : https://momodeveloper.mtn.com

# ── MOOV MONEY (Celtiis) ─────────────────────────────────────
MOOV_API_URL=https://api.moov-africa.bj
MOOV_API_KEY=your_moov_api_key
MOOV_MERCHANT_ID=your_merchant_id

# ── ORANGE MONEY ─────────────────────────────────────────────
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/bj/v1
ORANGE_MONEY_AUTH_URL=https://api.orange.com/oauth/v3/token
ORANGE_MONEY_CLIENT_ID=your_orange_client_id
ORANGE_MONEY_CLIENT_SECRET=your_orange_client_secret
# Protection provisoire du webhook en attendant le mécanisme de signature officiel Orange
ORANGE_MONEY_WEBHOOK_SECRET=your_orange_webhook_shared_secret

# ── QOSIC ────────────────────────────────────────────────────
QOSIC_BASE_URL=https://qosic.net/QOSIC_SERVER/api
QOSIC_CLIENT_ID=your_qosic_client_id
QOSIC_CLIENT_SECRET=your_qosic_client_secret

# ── GOOGLE MAPS PLATFORM ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSy...your_google_maps_api_key
# Activer dans Google Cloud Console :
# - Maps JavaScript API
# - Geocoding API
# - Directions API
# - Distance Matrix API
# - Places API

# ── MAPBOX ───────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VyIn0...
# Obtenir sur : https://mapbox.com → Account → Tokens

# ── WHATSAPP BUSINESS API (Meta) ─────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=EAAxxxx...your_permanent_token
WHATSAPP_VERIFY_TOKEN=wayi-webhook-verify-2026
# App Secret Facebook (onglet Paramètres de base de l'app Meta) — sert à vérifier la
# signature X-Hub-Signature-256 des webhooks entrants (voir routes/payments.js)
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_BUSINESS_ID=your_business_id
# Obtenir sur : https://developers.facebook.com → WhatsApp → Getting Started

# ── TWILIO SMS ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12025550123
# Obtenir sur : https://twilio.com → Console

# ── FIREBASE ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=wayi-app-2026
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@wayi-app-2026.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXX\n-----END PRIVATE KEY-----\n"
# Obtenir sur : https://console.firebase.google.com → Project Settings → Service Accounts

# ── ANTHROPIC CLAUDE API (Yivi IA) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxx...your_claude_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
# Obtenir sur : https://console.anthropic.com → API Keys

# ── ENVOI D'E-MAILS (code de vérification, confirmation de commande, reçu) ──
# Option A — SMTP classique (ex: Gmail) : prioritaire si les 3 valeurs sont remplies.
# Pour Gmail, SMTP_PASS doit être un "mot de passe d'application" généré sur
# https://myaccount.google.com/apppasswords (le mot de passe normal du compte
# ne fonctionne pas). Pour un autre hébergeur mail, demande host/port à ton fournisseur.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ton-adresse@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=WAYI <ton-adresse@gmail.com>

# Option B — Resend (utilisée seulement si SMTP_HOST n'est pas configuré)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Obtenir sur : https://resend.com → API Keys (compte gratuit, 100 e-mails/jour)
# Sans domaine vérifié sur Resend, tu peux quand même tester en envoyant uniquement
# à l'adresse e-mail associée à ton compte Resend.
# SANS cette clé, les e-mails ne partent jamais réellement : ils sont seulement
# affichés dans les logs du serveur (mode simulation), le code de vérification
# à l'inscription ne sera donc jamais reçu par e-mail tant qu'elle n'est pas configurée.

# ── SEGMENT (analytics) ──────────────────────────────────────
SEGMENT_WRITE_KEY=your_segment_write_key
# Obtenir sur : https://segment.com → Sources → Node.js

# ── REDIS (cache + Socket.io adapter) ────────────────────────
REDIS_URL=redis://localhost:6379
# En prod : Redis Cloud → https://redis.com/try-free

# ── APP CONFIG ───────────────────────────────────────────────
# ── CORS : sites autorisés à appeler l'API ───────────────────
# Déjà inclus dans le code (config/origins.js) : https://www.wayibenin.com,
# https://wayibenin.com, https://driver.wayibenin.com, https://admin.wayibenin.com.
# FRONTEND_URLS sert seulement à en AJOUTER (séparés par des virgules, sans « / » final).
# Les ports localhost (5173...) ne sont acceptés que si NODE_ENV n'est pas « production ».
FRONTEND_URLS=
# Site principal : utilisé pour les pages de retour de paiement.
FRONTEND_URL=https://www.wayibenin.com
WEBHOOK_BASE_URL=https://your-domain.com
APP_NAME=Wayi
APP_VERSION=2.0.0

# ── PARTENAIRES INSTITUTIONNELS ──────────────────────────────
# Ces partenaires ne nécessitent pas de clé API — contact direct requis
# CAME_BÉNIN=Contact : +229 21 33 01 23 — partenariat@came.bj
# ONPB=Contact : +229 21 31 49 92 — onpb@pharmaciens-benin.org
# GDIZ=Contact : gdiz@nicb.bj — Partenariat B2B livraisons
# AFRICYCLE=Contact : info@africycle.com — Flottes électriques
# DHL_BENIN=Contact : +229 21 31 53 31 — Wayi Send B2B
# SAVIU_VENTURES=contact@saviu.io — Levée de fonds
# FNPEEJ=fnpeej@gouv.bj — Fonds national entrepreneuriat

# ── CONNEXION GOOGLE (vérification réelle du jeton côté serveur) ─
GOOGLE_CLIENT_ID=123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Même valeur que VITE_GOOGLE_CLIENT_ID côté client (voir apps/client/.env.example).
# Le serveur vérifie ici que le jeton reçu a bien été émis par Google pour CETTE
# application précise, avant de faire confiance à l'e-mail qu'il contient.
# SANS cette variable, /api/auth/social refuse toute connexion Google (erreur 503
# explicite), il n'y a pas de repli silencieux vers une fausse connexion.

# ── CONNEXION FACEBOOK (vérification réelle du jeton côté serveur) ─
FACEBOOK_APP_ID=1234567890123456
# Même valeur que VITE_FACEBOOK_APP_ID côté client.
# Le serveur interroge l'API Graph de Facebook avec le jeton reçu pour récupérer le
# vrai nom et le vrai e-mail du compte, ce qui invalide de fait tout jeton invalide
# ou expiré.
# SANS cette variable, /api/auth/social refuse toute connexion Facebook (erreur 503
# explicite), il n'y a pas de repli silencieux vers une fausse connexion.

# Contacts du service client que Yivi donne aux clients (facultatif, laisser vide si pas encore)
SUPPORT_WHATSAPP=
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Adresse publique de l API (pour les liens des photos de plats), ex : https://api.wayibenin.com
PUBLIC_API_URL=https://api.wayibenin.com
